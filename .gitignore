# macOS
.DS_Store

# Dependencies
node_modules/

# Build output
.next/
dist/
build/
.astro/

# Environment
.env
.env.*
!.env.example

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# AI tooling
.claude
.commandcode
.zcode

# Downloadable documents (personal files)
frontend/assets/documents/*
backend/documents/*

# Data-sync export/snapshot artifacts (build outputs, not source)
backend/portfolio-data-*.zip
backend/portfolio-snapshot-*.zip
backend/portfolio-projects-*.zip
backend/payload.test.db*

# Content pipeline (sprint-23): git is the source of truth for articles/projects.
# zips are build artifacts (regeneratable); drafts are private raw notes — both ignored.
# The import-source rows under content/ ARE tracked.
tools/repo-to-project/collection/
tools/article-polish/collection/
tools/collection/

# repo-to-project: content rows are tracked, but drafts are private raw notes
tools/repo-to-project/content/*/draft/

# article-polish: ignore everything under content/ except the import source + review artifact
# (flat per-slug layout, same shape as repo-to-project: content/<slug>/{draft/, article.md, article.json})
# article.id.* = optional Indonesian overlay sibling (sprint-24) — must be tracked for bilingual publishes
tools/article-polish/content/**
!tools/article-polish/content/**/
!tools/article-polish/content/*/article.json
!tools/article-polish/content/*/article.md
!tools/article-polish/content/*/article.id.json
!tools/article-polish/content/*/article.id.md

# article-polish samples — keep the folder, ignore contents
tools/article-polish/samples/*
!tools/article-polish/samples/.gitkeep

# Temp / misc
temp
*.log
*.tsbuildinfo
*.bak
