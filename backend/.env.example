# PayloadCMS secret — used to sign admin JWTs. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=your-secret-here

# Database URL — file-based SQLite is fine for this portfolio
DATABASE_URL=file:./payload.db

# CORS origins — comma-separated domains that can access the admin Panel
PAYLOAD_PUBLIC_CORS=http://localhost:4321

# ──────────────────────────────────────────────────────
# First deploy:
#   1. Copy this file: cp .env.example .env
#   2. Change PAYLOAD_SECRET to a real value
#   3. Run: npm run seed        (populates the database)
#   4. Run: npm run start        (starts PayloadCMS on :3000)
#
# Subsequent deploys:
#   Deploy script handles build + restart. Seed is manual —
#   only run `npm run seed` when you add new content.
#
#   To preview what would be seeded before writing:
#   npm run seed:dry
# ──────────────────────────────────────────────────────
