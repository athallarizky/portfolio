---
// Language switch (sprint-26): a sliding on/off-style toggle. The knob carries the
// CURRENT locale's flag; the dimmed flag on the other side hints where the click goes.
// One anchor to the counterpart URL — pure CSS, no JS island.
interface Props {
  current: 'en' | 'id'
  enHref: string
  idHref: string
}

const { current, enHref, idHref } = Astro.props;

const target =
  current === 'en'
    ? { href: idHref, label: 'Baca dalam Bahasa Indonesia' }
    : { href: enHref, label: 'Read in English' };
---

<a href={target.href} class="lang-toggle" title={target.label} aria-label={target.label}>
  <span class="lang-toggle-track">
    <span class="lang-toggle-opt" aria-hidden="true">🇬🇧</span>
    <span class="lang-toggle-opt" aria-hidden="true">🇮🇩</span>
    <span class:list={['lang-toggle-knob', current === 'id' && 'is-id']} aria-hidden="true">
      {current === 'en' ? '🇬🇧' : '🇮🇩'}
    </span>
  </span>
</a>

<!-- Switching locale must REPLACE the history entry, not push — rapid EN↔ID toggling
     would otherwise bury the real previous page in the back stack. Delegated + guarded
     so multiple instances on one page bind exactly one listener. -->
<script is:inline>
  (function () {
    if (window.__langToggleReplace) return;
    window.__langToggleReplace = true;
    document.addEventListener('click', function (e) {
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var a = e.target.closest && e.target.closest('a.lang-toggle');
      if (!a) return;
      e.preventDefault();
      location.replace(a.href);
    });
  })();
</script>
