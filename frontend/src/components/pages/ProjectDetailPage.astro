---
// Shared project detail (sprint-25) — renders /projects/[slug] (EN) and /id/projects/[slug].
// Pure presentation: the route owns fetch + redirects (see lib/content.ts + the route files).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderLexical } from '../../lib/render-lexical';
import { localePath, type Locale } from '../../lib/i18n';
import { bannerUrlOf } from '../../lib/content';
import LangSwitcher from '../LangSwitcher.astro';
import Screenshots from '../project/Screenshots.svelte';
import type { Project } from '../../lib/api-types';

interface Props {
  locale?: Locale;
  project: Project;
  translated: boolean;
  nextProject: Project | null;
  otherProjects: Project[];
}

const { locale = 'en', project, translated, nextProject, otherProjects } = Astro.props;
const slug = project.slug;

const bannerUrl = bannerUrlOf(project.bannerImage);
const detailBase = locale === 'id' ? '/id/projects' : '/projects';
const features = project.features || [];
---

<BaseLayout
  title={project.title}
  pageTitle={project.title}
  activeNav="/projects"
  mesh={false}
  lang={locale}
  description={project.excerpt || `${project.descriptor || project.title}${project.year ? ` (${project.year})` : ''} — a project by Athalla Rizky.`}
  alternates={translated
    ? [
        { hreflang: 'en', href: `/projects/${slug}` },
        { hreflang: 'id', href: `/id/projects/${slug}` },
        { hreflang: 'x-default', href: `/projects/${slug}` },
      ]
    : []}
>
  <div class="article-layout mt-4">
    <div class="article-main">
      <div class="detail-header">
        {bannerUrl ? (
          <div style="height: 180px; border-radius: 16px; background: var(--card); overflow:hidden;">
            <img src={bannerUrl} alt={project.title} style="width:100%; height:100%; object-fit:cover;" loading="lazy" />
          </div>
        ) : (
          <div style={`height: 180px; border-radius: 16px; background: ${project.bannerColor}; display:flex; align-items:center; justify-content:center;`}>
            <iconify-icon icon={project.bannerIcon || 'solar:rocket-bold'} width="72" height="72" style="color:#fff; opacity:.7;"></iconify-icon>
          </div>
        )}
        <div class="flex items-start justify-between gap-2" style="margin-top:1rem">
          <div>
            <div class="detail-title">{project.title}</div>
            <div class="detail-subtitle">{project.descriptor} · {project.year}</div>
          </div>
          {translated && (
            <LangSwitcher current={locale} enHref={`/projects/${slug}`} idHref={`/id/projects/${slug}`} />
          )}
        </div>
        <div class="flex gap-2 mt-2">
          {project.links.map((l) => (
            <a class="btn btn-outline" href={l.url || '#'} target="_blank" rel="noopener">
              <iconify-icon icon={l.icon || 'solar:link-circle-bold'} width="16" height="16"></iconify-icon>
              {l.label}
            </a>
          ))}
        </div>
      </div>

      <div class="prose mt-4" set:html={renderLexical(project.body)}></div>

      {project.techTags.length > 0 && (
        <section class="project-section">
          <h3>Tech stack</h3>
          <div class="flex flex-wrap gap-1">
            {project.techTags.map((t) => (
              <span class="tag is-secondary tech-chip">
                {t.icon && <iconify-icon icon={t.icon} width="14" height="14"></iconify-icon>}
                {t.name}
              </span>
            ))}
          </div>
        </section>
      )}

      {features.length > 0 && (
        <section class="project-section">
          <h3>Features</h3>
          <ul class="feature-list grid-2">
            {features.map((f) => (
              <li>
                <iconify-icon icon={f.icon || 'solar:check-circle-linear'} width="20" height="20"></iconify-icon>
                <div>
                  <strong>{f.heading}</strong>
                  <p class="text-desc text-sm">{f.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      {project.screenshots.length > 0 && (
        <section class="project-section">
          <h3>Screenshots</h3>
          <Screenshots client:visible items={project.screenshots} />
        </section>
      )}

      {project.architecture && (
        <section class="project-section">
          <h3>Architecture</h3>
          <pre class="card" style="padding:1rem; overflow-x:auto; font-family:ui-monospace,monospace; font-size:.8125rem;">
            <code>{project.architecture}</code>
          </pre>
        </section>
      )}

      {nextProject && (
        <div class="mt-4" style="text-align:right;">
          <a class="btn btn-ghost" href={`${detailBase}/${nextProject.slug}`}>
            Next project: {nextProject.title}
            <iconify-icon icon="solar:alt-arrow-right-linear" width="16" height="16"></iconify-icon>
          </a>
        </div>
      )}
    </div>

    <aside class="other-projects-sidebar">
      <h3 class="filter-head">
        <iconify-icon icon="solar:folder-open-outline" width="16" height="16"></iconify-icon>
        Other projects
      </h3>
      {otherProjects.map((p) => (
        <a class="related-item" href={`${detailBase}/${p.slug}`}>
          <span class="card-title" style="font-size:.875rem;">{p.title}</span>
          <span class="text-desc text-xs">{p.descriptor}{p.year ? ` · ${p.year}` : ''}</span>
        </a>
      ))}
      <a class="all-articles-link" href={localePath(locale, '/projects')}>
        All projects
        <iconify-icon icon="solar:alt-arrow-right-linear" width="14" height="14"></iconify-icon>
      </a>
    </aside>
  </div>
</BaseLayout>
