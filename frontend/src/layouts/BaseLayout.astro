---
import '../styles/styles.css';
import Sidebar from '../components/shell/Sidebar.svelte';
import Header from '../components/shell/Header.svelte';
import { safeFetch } from '../lib/api';
import type { Nav, SiteConfig } from '../lib/api-types';

const nav = await safeFetch<Nav>('/globals/nav');
const siteConfig = await safeFetch<SiteConfig>('/globals/site-config');

interface Props {
  title: string;
  pageTitle: string;
  activeNav: string;
}

const { title, pageTitle, activeNav } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Personal portfolio — full-stack engineer, backend systems, AI tooling." />
  <meta name="theme-color" content="#c35af7" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${title} — Portfolio`} />
  <meta property="og:description" content="Full-stack engineer — backend systems, AI tooling, developer experience." />
  <meta property="og:site_name" content="Portfolio" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={`${title} — Portfolio`} />
  <meta name="twitter:description" content="Full-stack engineer — backend systems, AI tooling, developer experience." />

  <!-- Canonical -->
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.url.origin).href} />

  <title>{title} — Portfolio</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />

  <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js" is:inline></script>

  <script is:inline>
    (function() {
      var t = localStorage.getItem('portfolio-theme');
      if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      if (t === 'dark') document.documentElement.classList.add('dark');
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="layout">
    <Sidebar
      client:load
      activeNav={activeNav}
      menuItems={nav.menuItems || []}
      connectLinks={nav.connectLinks || []}
      initials={siteConfig.initials || '??'}
      name={siteConfig.name || 'Portfolio'}
      role={siteConfig.role || ''}
    />

    <main class="main" id="main" tabindex="-1">
      <Header client:load pageTitle={pageTitle}>
        {Astro.slots.headerRight && <Fragment slot="header-right"><slot name="headerRight" /></Fragment>}
      </Header>

      <div class="content-scroll">
        <div class="layout-container">
          <div class="corner-blob"></div>
          <div class="content-inner">
            <slot />
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
