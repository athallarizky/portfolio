---
import '../styles/styles.css';
import Sidebar from '../components/shell/Sidebar.svelte';
import Header from '../components/shell/Header.svelte';
import { safeFetch } from '../lib/api';
import type { Nav, SiteConfig } from '../lib/api-types';

const nav = await safeFetch<Nav>('/globals/nav');
const siteConfig = await safeFetch<SiteConfig>('/globals/site-config');

const contactEnabled = siteConfig.contactFormEnabled !== false;
const docsEnabled = siteConfig.documentsEnabled !== false;

const filteredMenu = (nav.menuItems || []).filter((item) => {
  if (!contactEnabled && item.href === '/contact') return false;
  if (!docsEnabled && item.href === '/documents') return false;
  return true;
});

interface Props {
  title: string;
  pageTitle: string;
  activeNav: string;
  description?: string;
  image?: string;
  mesh?: boolean;
  /** Content language of this page (`<html lang>`) — 'id' on the /id/ zone (sprint-25). */
  lang?: string;
  /** hreflang alternates (relative hrefs, absolutized here). Empty on pages without a
   *  counterpart (e.g. an untranslated article's EN page). */
  alternates?: { hreflang: string; href: string }[];
}

const {
  title,
  pageTitle,
  activeNav,
  description = 'Full-stack engineer — backend systems, AI tooling, developer experience.',
  image = '/og.png',
  mesh = true,
  lang = 'en',
  alternates = [],
} = Astro.props;

// sprint-13: stable absolute URLs (Astro.site is set in astro.config.mjs).
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(image, origin).href;
const alternateLinks = alternates.map((a) => ({
  hreflang: a.hreflang,
  href: new URL(a.href, origin).href,
}));
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#5645d4" />
  <meta name="author" content="Athalla Rizky" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${title} — Portfolio`} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="Athalla Rizky — Portfolio" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} — Portfolio`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Canonical -->
  <link rel="canonical" href={canonical} />

  <!-- hreflang alternates (sprint-25: en ↔ id + x-default on the content routes) -->
  {alternateLinks.map((a) => (
    <link rel="alternate" hreflang={a.hreflang} href={a.href} />
  ))}

  <title>{title} — Portfolio</title>

  <!-- Structured data (sprint-13) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Athalla Rizky",
    "url": "https://athallarizky.com",
    "jobTitle": "Full-Stack Engineer",
    "description": description,
  })} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />

  <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js" is:inline></script>

  <script is:inline>
    (function() {
      var t = localStorage.getItem('portfolio-theme');
      if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      if (t === 'dark') document.documentElement.classList.add('dark');
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="layout">
    <Sidebar
      client:load
      activeNav={activeNav}
      menuItems={filteredMenu}
      connectLinks={nav.connectLinks || []}
      initials={siteConfig.initials || '??'}
      name={siteConfig.name || 'Portfolio'}
      role={siteConfig.role || ''}
    />

    <main class="main" id="main" tabindex="-1">
      <Header client:load pageTitle={pageTitle}>
        {Astro.slots.headerRight && <Fragment slot="header-right"><slot name="headerRight" /></Fragment>}
      </Header>

      <div class="content-scroll">
        <div class="layout-container">
          <div class="corner-blob"></div>
          <div class="content-inner">
            {mesh && <div class="home-mesh" aria-hidden="true"></div>}
            <slot />
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
