---
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.status = 404;
---

<BaseLayout title="404" pageTitle="404" activeNav="">
  <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:60vh; text-align:center;">
    <span style="font-size:4rem; font-weight:900; color:var(--secondary);">404</span>
    <h1 style="font-size:1.5rem; font-weight:700; margin:.5rem 0;">Page not found</h1>
    <p class="text-desc text-sm" style="max-width:320px;">The page you're looking for doesn't exist or has been moved.</p>
    <a class="btn btn-primary mt-4" href="/">
      <iconify-icon icon="solar:home-2-linear" width="16" height="16"></iconify-icon>
      Back to Home
    </a>
  </div>
</BaseLayout>
