---
import BlogDetailPage from '../../components/pages/BlogDetailPage.astro';
import { loadArticleDetail } from '../../lib/content';

export const prerender = false;

const data = await loadArticleDetail('en', Astro.params.slug);
if (data.status === 'not-found') {
  return Astro.redirect('/404');
}
---

<BlogDetailPage
  locale="en"
  article={data.doc}
  translated={data.translated}
  relatedArticles={data.relatedArticles ?? []}
/>
