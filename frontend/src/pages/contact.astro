---
import BaseLayout from '../layouts/BaseLayout.astro';
import { safeFetch } from '../lib/api';
import type { SiteConfig } from '../lib/api-types';

const siteConfig = await safeFetch<SiteConfig>('/globals/site-config');
const contactEnabled = siteConfig.contactFormEnabled !== false;
---

<BaseLayout title="Contact" pageTitle="Contact" activeNav="/contact">
  {contactEnabled ? (
    <div>
      <p class="text-desc text-sm mb-4">
        Have a project in mind, a question, or just want to say hi? Drop a message below.
      </p>

      <div class="grid-2">
        <section class="card">
          <div class="card-header">
            <iconify-icon icon="solar:letter-outline" width="18" height="18"></iconify-icon>
            <span class="card-title">Send a message</span>
          </div>

          <form id="contact-form" class="contact-form">
            <div class="form-group">
              <label class="form-label" for="contact-name">Name</label>
              <input id="contact-name" type="text" name="name" class="form-input" required placeholder="Your name" autocomplete="name" />
            </div>
            <div class="form-group">
              <label class="form-label" for="contact-email">Email</label>
              <input id="contact-email" type="email" name="email" class="form-input" required placeholder="you@example.com" autocomplete="email" />
            </div>
            <div class="form-group">
              <label class="form-label" for="contact-message">Message</label>
              <textarea id="contact-message" name="message" class="form-input form-textarea" required rows="5" placeholder="What's on your mind?"></textarea>
            </div>
            <button type="submit" class="btn btn-primary contact-submit">
              <iconify-icon icon="solar:letter-outline" width="16" height="16"></iconify-icon>
              <span class="btn-label">Send message</span>
            </button>
            <div id="form-status" class="form-status" style="display:none;" role="status" aria-live="polite"></div>
          </form>
        </section>

        <section class="card">
          <div class="card-header">
            <iconify-icon icon="solar:chat-round-dots-linear" width="18" height="18"></iconify-icon>
            <span class="card-title">Other ways to reach me</span>
          </div>
          <div class="contact-alt">
            <a class="contact-alt-item" href="mailto:hello@atha.dev">
              <iconify-icon icon="solar:letter-bold-duotone" width="20" height="20"></iconify-icon>
              <div>
                <span class="card-title">Email</span>
                <span class="text-desc text-sm">hello@atha.dev</span>
              </div>
            </a>
            <a class="contact-alt-item" href="https://github.com/athallarizky" target="_blank" rel="noopener">
              <iconify-icon icon="simple-icons:github" width="20" height="20"></iconify-icon>
              <div>
                <span class="card-title">GitHub</span>
                <span class="text-desc text-sm">@athallarizky</span>
              </div>
            </a>
          </div>
        </section>
      </div>
    </div>
  ) : (
    <div class="card" style="display:flex; flex-direction:column; align-items:center; padding:3rem;">
      <iconify-icon icon="solar:chat-round-dots-linear" width="48" height="48" style="color:var(--secondary); margin-bottom:1rem;"></iconify-icon>
      <h2 class="card-title">Contact temporarily unavailable</h2>
      <p class="text-desc text-sm mt-2">The contact form is disabled right now. Reach me on socials or try again later.</p>
    </div>
  )}
</BaseLayout>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    var status = document.getElementById('form-status');
    var btn = form.querySelector('button.contact-submit');
    var btnLabel = btn.querySelector('.btn-label');
    function setStatus(cls, msg) {
      status.textContent = msg;
      status.className = 'form-status ' + cls;
      status.style.display = 'block';
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      var name = form.name.value.trim();
      var email = form.email.value.trim();
      var message = form.message.value.trim();

      if (!name || !email || !message) {
        setStatus('form-status-error', 'Please fill in all fields.');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setStatus('form-status-error', 'Please enter a valid email address.');
        return;
      }

      btn.disabled = true;
      btnLabel.textContent = 'Sending…';
      status.style.display = 'none';

      try {
        var res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: name, email: email, message: message }),
        });

        if (res.ok) {
          setStatus('form-status-success', "&#10003; Message sent! I'll get back to you soon.");
          form.reset();
        } else {
          var data = await res.json().catch(function () { return {}; });
          setStatus('form-status-error', data.error || 'Something went wrong. Try emailing me directly.');
        }
      } catch (err) {
        setStatus('form-status-error', 'Network error — please try again or email me directly.');
      }

      btn.disabled = false;
      btnLabel.textContent = 'Send message';
    });
  })();
</script>
