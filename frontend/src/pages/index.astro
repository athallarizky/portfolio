---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypedRole from '../components/home/TypedRole.svelte';
import CountUpStats from '../components/home/CountUpStats.svelte';
import SpotlightEffect from '../components/home/SpotlightEffect.svelte';
import LiveClock from '../components/home/LiveClock.svelte';
import MagneticButton from '../components/home/MagneticButton.svelte';
import Reveal from '../components/home/Reveal.svelte';
import GlowGrid from '../components/home/GlowGrid.svelte';
import { safeFetch } from '../lib/api';
import type { Home, SiteConfig, SocialProfile, PaginatedResponse, Project, Article } from '../lib/api-types';

const home = await safeFetch<Home>('/globals/home');
const siteConfig = await safeFetch<SiteConfig>('/globals/site-config');
const socialProfiles = await safeFetch<PaginatedResponse<SocialProfile>>('/social-profiles?sort=order');
const selectedWork = await safeFetch<PaginatedResponse<Project>>(
  '/projects?where[showOnHome][equals]=true&where[status][equals]=published&sort=order&limit=3&depth=1',
);
const latestWriting = await safeFetch<PaginatedResponse<Article>>(
  '/articles?where[status][equals]=published&sort=-publishedAt&limit=3&select[title]=true&select[slug]=true&select[publishedAt]=true',
);

const homeProfiles = (socialProfiles.docs || []).filter((p: SocialProfile) => p.showOnHome);
const workDocs = selectedWork.docs || [];
const writeDocs = latestWriting.docs || [];

const visible = new Set(
  home.showItems || ['hero', 'stats', 'featuredProjects', 'latestWriting', 'about', 'currently', 'skills', 'findMe', 'contactCta'],
);

const hero = home.hero || { eyebrow: '', name: 'Portfolio' };
const about = home.about || [];
const currently = home.currently || [];
const skills = home.skills || [];
const stats = home.stats || [];
---

<BaseLayout title="Home" pageTitle="Home" activeNav="/" description="Athalla Rizky — full-stack engineer building backend systems, AI tooling, and developer experience. Selected work, writing, and projects.">
  <div class="home">
    {/* HERO — load-time reveal (unchanged) */}
    {visible.has('hero') && (
    <section class="hero reveal" id="hero" style="--d:.04s">
      <div class="hero-grid"></div>
      <SpotlightEffect client:visible />
      <div class="hero-row">
        <div class="hero-avatar">
          <div class="avatar hero-avatar-face">{siteConfig.initials || '??'}</div>
          <span class="hero-status-dot" title="Available"></span>
        </div>
        <div class="hero-intro">
          <span class="hero-eyebrow">{hero.eyebrow}</span>
          <h1 class="hero-name">{hero.name}</h1>
          <p class="hero-role">
            <TypedRole client:visible roles={home.roles || []} />
          </p>
          <div class="hero-meta">
            {siteConfig.status && (
              <span class="hero-chip">
                <iconify-icon icon="solar:case-line-duotone" width="14" height="14"></iconify-icon>
                {siteConfig.status}
              </span>
            )}
            <LiveClock client:visible timezone={siteConfig.timezone || 'UTC+7'} />
          </div>
        </div>
      </div>
      <div class="hero-actions">
        <MagneticButton client:visible>
          <a class="btn btn-primary" href="/projects">
            <iconify-icon icon="solar:rocket-bold" width="16" height="16"></iconify-icon>
            View Projects
          </a>
        </MagneticButton>
        <MagneticButton client:visible>
          <a class="btn btn-outline" href="/blogs">
            <iconify-icon icon="solar:document-add-outline" width="16" height="16"></iconify-icon>
            Read the blog
          </a>
        </MagneticButton>
      </div>
    </section>
    )}

    {/* STATS — load-time reveal (CountUpStats unchanged) */}
    {visible.has('stats') && <CountUpStats client:visible stats={stats} />}

    {/* ABOUT + CURRENTLY — scroll reveal */}
    {(visible.has('about') || visible.has('currently')) && (
      <Reveal client:visible delay=".05s">
        <div class="grid-2">

          {/* ABOUT */}
          {visible.has('about') && (
          <section class="card is-hoverable glowable">
            <div class="card-header">
              <iconify-icon icon="solar:user-id-outline" width="18" height="18"></iconify-icon>
              <span class="card-title">About</span>
            </div>
            {about.map((p) => (
              <p class="text-desc text-sm" style="margin-top:.5rem">{p.paragraph}</p>
            ))}
          </section>
          )}

          {/* CURRENTLY */}
          {visible.has('currently') && (
          <section class="card is-hoverable glowable is-currently">
            <div class="card-header">
              <iconify-icon icon="solar:planet-3-linear" width="18" height="18"></iconify-icon>
              <span class="card-title">Currently</span>
            </div>
            <ul class="now-list">
              {currently.map((item) => (
                <li>
                  <iconify-icon icon={item.icon || 'solar:book-2-linear'} width="16" height="16"></iconify-icon>
                  <span class="text-desc text-sm">{item.text}</span>
                </li>
              ))}
            </ul>
          </section>
          )}
        </div>
      </Reveal>
    )}

    {/* SKILLS + FIND ME — scroll reveal + skill stagger */}
    {(visible.has('skills') || visible.has('findMe')) && (
      <Reveal client:visible delay=".05s">
        <div class="grid-2">
          {visible.has('skills') && (
          <section class="card is-hoverable glowable">
            <div class="card-header">
              <iconify-icon icon="solar:code-bold-duotone" width="18" height="18"></iconify-icon>
              <span class="card-title">Skills</span>
            </div>
            <div class="flex flex-wrap gap-1 mt-2 skills-chips">
              {skills.map((s, i) => (
                <span class="tag is-secondary" style={`--i:${i}`}>{s.name}</span>
              ))}
            </div>
          </section>
          )}
          {visible.has('findMe') && (
          <section class="card is-hoverable glowable">
            <div class="card-header">
              <iconify-icon icon="solar:link-circle-bold" width="18" height="18"></iconify-icon>
              <span class="card-title">Find me</span>
            </div>
            <div class="flex flex-wrap gap-1 mt-2">
              {homeProfiles.map((p) => (
                <a class="findme-link" href={p.url} target="_blank" rel="noopener">
                  <iconify-icon icon={p.icon} width="14" height="14"></iconify-icon>
                  {p.platform}
                </a>
              ))}
            </div>
          </section>
          )}
        </div>
      </Reveal>
    )}

    {/* SELECTED WORK — scroll reveal + cursor glow */}
    {visible.has('featuredProjects') && workDocs.length > 0 && (
      <Reveal client:visible delay=".05s">
        <GlowGrid client:visible>
          <section class="home-section work-strip">
            <header class="section-head">
              <h2 class="section-title">Selected work</h2>
              <a class="section-link" href="/projects">All projects →</a>
            </header>
            <div class="grid-3">
              {workDocs.map((p: Project) => (
                <a class="work-card glowable" href={`/projects/${p.slug}`}>
                  <span class="work-icon" style={p.bannerColor ? `background:${p.bannerColor}` : ''}>
                    <iconify-icon icon={p.bannerIcon || 'solar:folder-bold-duotone'} width="20" height="20" />
                  </span>
                  <h3 class="work-title">{p.title}</h3>
                  {p.excerpt && <p class="text-desc text-sm work-excerpt">{p.excerpt}</p>}
                  <div class="flex flex-wrap gap-1 work-tags">
                    {p.techTags?.map((t, i) => (
                      <span class={`tag-badge tint-${i % 4}`}>{t.name}</span>
                    ))}
                  </div>
                </a>
              ))}
            </div>
          </section>
        </GlowGrid>
      </Reveal>
    )}

    {/* LATEST WRITING — scroll reveal */}
    {visible.has('latestWriting') && writeDocs.length > 0 && (
      <Reveal client:visible delay=".05s">
        <section class="home-section writing-strip">
          <header class="section-head">
            <h2 class="section-title">Latest writing</h2>
            <a class="section-link" href="/blogs">All writing →</a>
          </header>
          <div class="write-list">
            {writeDocs.map((a: Article) => (
              <a class="write-row" href={`/blogs/${a.slug}`}>
                <span class="write-title">{a.title}</span>
                <span class="write-date">
                  {new Date(a.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
                <iconify-icon icon="solar:arrow-right-linear" width="16" height="16" class="write-arrow" />
              </a>
            ))}
          </div>
        </section>
      </Reveal>
    )}

    {/* CONTACT CTA — scroll reveal + magnetic button */}
    {visible.has('contactCta') && (
      <Reveal client:visible delay=".05s">
        <div class="card is-hoverable glowable contact-cta mt-4">
          <iconify-icon icon="solar:chat-round-dots-linear" width="32" height="32" style="color:var(--secondary);"></iconify-icon>
          <h3 class="contact-cta-title">Let's talk</h3>
          <p class="text-desc text-sm contact-cta-sub">Have a project in mind or just want to say hi? My inbox is open.</p>
          <MagneticButton client:visible>
            <a class="btn btn-primary" href="/contact">
              <iconify-icon icon="solar:letter-outline" width="16" height="16"></iconify-icon>
              Get in touch
            </a>
          </MagneticButton>
        </div>
      </Reveal>
    )}

    <div class="home-foot mt-4 text-center text-desc text-sm">
      Made with <iconify-icon icon="solar:heart-bold" width="14" height="14" style="color:var(--secondary); vertical-align:middle;"></iconify-icon> by {siteConfig.name}
    </div>
  </div>
</BaseLayout>
